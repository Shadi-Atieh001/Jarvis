{
  "manifest_version": 3,
  "name": "JARVIS",
  "version": "1.1.0",
  "description": "Lets your own JARVIS assistant, running on this computer, read and work web pages in this browser.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "JARVIS", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
